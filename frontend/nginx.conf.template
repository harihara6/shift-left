# Serves the built Angular app and proxies /api to the backend.
# Rendered by the nginx image's envsubst step: ${BACKEND_URL} comes from the environment.
#
# In production an SSO proxy sits in front of this server. It authenticates the person and sets
# X-ShiftLeft-User / X-ShiftLeft-Groups / X-ShiftLeft-Proxy-Secret; this server passes them on.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 60s;
        client_max_body_size 1m;
    }

    # Hashed bundles never change under the same name, so they can be cached for good.
    location ~* \.(?:js|css|woff2?)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The shell must always be fresh, or a deploy leaves people on the previous bundle.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
